{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/worker.test.ts",
    "test:workerd": "vitest run test/workerd.runtime.test.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --target=es2022 --outfile=dist-worker/index.js",
    "predeploy:staging": "tsx scripts/predeploy-check.ts --target=staging",
    "deploy:staging": "wrangler deploy --env staging --no-x-provision",
    "deploy:staging:dry-run": "tsx scripts/predeploy-check.ts --target=staging && wrangler deploy --env staging --no-x-provision --dry-run"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "hono": "^4.13.22",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
